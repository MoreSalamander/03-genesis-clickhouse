# Genesis OS — Institutional Intelligence (ClickHouse track)
# Copy to .env and fill in. With nothing set, the system boots fully in MOCK mode.

# --- Google Cloud (runtime cognition — required for LIVE mode) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-flash-latest
# or, instead of Vertex: GOOGLE_API_KEY=...

# --- ClickHouse (analytical substrate; ops/docker-compose.yml defaults) ---
# Agents reach ClickHouse ONLY through the official mcp-clickhouse server:
CLICKHOUSE_MCP_URL=http://localhost:8687/mcp
CLICKHOUSE_MCP_TOKEN=genesis-institutional-mcp
# Seeder + ingest worker write directly (never through MCP):
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=genesis_institutional
CLICKHOUSE_WRITER_USER=genesis
CLICKHOUSE_WRITER_PASSWORD=genesis-institutional

# --- Preserved stack (defaults match ops/docker-compose.yml) ---
POSTGRES_DSN=postgresql://genesis:genesis@localhost:5435/genesis_institutional
NATS_URL=nats://localhost:4225
TEMPORAL_ADDRESS=localhost:7235
REDIS_URL=redis://localhost:6382/0
DATAHUB_GMS_URL=http://localhost:8080
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional: mirror 01/02 event fabrics into ops_events (03 runs fully without them)
INGEST_SOURCES=nats://localhost:4223=genesis.signal.events,nats://localhost:4224=genesis.ops.events

# GENESIS_MOCK=1        # force mock mode everywhere
# GENESIS_SITE=local
